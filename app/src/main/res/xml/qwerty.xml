<!-- fcitx5-android "Material" row structure: q-p / a-l / shift+z-m+del /
     123+comma+lang+space+period+return -->
<Keyboard xmlns:android="http://schemas.android.com/apk/res/android"
    android:keyWidth="@dimen/key_width"
    android:keyHeight="@dimen/key_height"
    >
    <Row>
        <Key android:codes="113" android:keyLabel="q"/>
        <Key android:codes="119" android:keyLabel="w"/>
        <Key android:codes="101" android:keyLabel="e"/>
        <Key android:codes="114" android:keyLabel="r"/>
        <Key android:codes="116" android:keyLabel="t"/>
        <Key android:codes="121" android:keyLabel="y"/>
        <Key android:codes="117" android:keyLabel="u"/>
        <Key android:codes="105" android:keyLabel="i"/>
        <Key android:codes="111" android:keyLabel="o"/>
        <Key android:codes="112" android:keyLabel="p"/>
    </Row>

    <Row>
        <Key android:codes="97" android:keyLabel="a" android:keyWidth="11%p"/>
        <Key android:codes="115" android:keyLabel="s" android:keyWidth="11%p"/>
        <Key android:codes="100" android:keyLabel="d" android:keyWidth="11%p"/>
        <Key android:codes="102" android:keyLabel="f" android:keyWidth="11%p"/>
        <Key android:codes="103" android:keyLabel="g" android:keyWidth="11%p"/>
        <Key android:codes="104" android:keyLabel="h" android:keyWidth="11%p"/>
        <Key android:codes="106" android:keyLabel="j" android:keyWidth="11%p"/>
        <Key android:codes="107" android:keyLabel="k" android:keyWidth="11%p"/>
        <Key android:codes="108" android:keyLabel="l" android:keyWidth="11%p"/>
    </Row>

    <Row>
        <Key android:codes="-1" android:keyIcon="@drawable/ic_key_shift"
            android:keyWidth="@dimen/key_width_action" android:isModifier="true" android:isSticky="true"/>
        <Key android:codes="122" android:keyLabel="z"/>
        <Key android:codes="120" android:keyLabel="x"/>
        <Key android:codes="99" android:keyLabel="c"/>
        <Key android:codes="118" android:keyLabel="v"/>
        <Key android:codes="98" android:keyLabel="b"/>
        <Key android:codes="110" android:keyLabel="n"/>
        <Key android:codes="109" android:keyLabel="m"/>
        <Key android:codes="-5" android:keyIcon="@drawable/ic_key_backspace"
            android:keyWidth="@dimen/key_width_action" android:isRepeatable="true"/>
    </Row>

    <Row android:rowEdgeFlags="bottom">
        <Key android:codes="-2" android:keyLabel="123" android:keyWidth="@dimen/key_width_action"/>
        <Key android:codes="44" android:keyLabel=","/>
        <Key android:codes="-101" android:keyIcon="@drawable/ic_key_language"/>
        <Key android:codes="32" android:keyLabel=" " android:keyWidth="@dimen/key_width_space"/>
        <Key android:codes="46" android:keyLabel="."/>
        <Key android:codes="-4" android:keyIcon="@drawable/ic_key_return" android:keyWidth="@dimen/key_width_action"/>
    </Row>
</Keyboard>
