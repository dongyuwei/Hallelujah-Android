<?xml version="1.0" encoding="utf-8"?>
<!-- Modifier key (shift / backspace / symbol-switch / language / bottom punctuation). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <inset android:insetLeft="@dimen/key_bg_margin_h" android:insetRight="@dimen/key_bg_margin_h"
               android:insetTop="@dimen/key_bg_margin_v" android:insetBottom="@dimen/key_bg_margin_v">
            <shape android:shape="rectangle">
                <solid android:color="@color/key_bg_alt_pressed"/>
                <corners android:radius="@dimen/key_bg_radius"/>
            </shape>
        </inset>
    </item>
    <item android:state_checked="true">
        <inset android:insetLeft="@dimen/key_bg_margin_h" android:insetRight="@dimen/key_bg_margin_h"
               android:insetTop="@dimen/key_bg_margin_v" android:insetBottom="@dimen/key_bg_margin_v">
            <shape android:shape="rectangle">
                <solid android:color="@color/key_bg_alt_checked"/>
                <corners android:radius="@dimen/key_bg_radius"/>
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetLeft="@dimen/key_bg_margin_h" android:insetRight="@dimen/key_bg_margin_h"
               android:insetTop="@dimen/key_bg_margin_v" android:insetBottom="@dimen/key_bg_margin_v">
            <shape android:shape="rectangle">
                <solid android:color="@color/key_bg_alt"/>
                <corners android:radius="@dimen/key_bg_radius"/>
            </shape>
        </inset>
    </item>
</selector>
